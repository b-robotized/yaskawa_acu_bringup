<?xml version="1.0" encoding="UTF-8"?>
<!-- Semantic description of the NHC12. -->
<robot name="motoman_nhc12" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="yaskawa"/>
  <xacro:arg name="robot_model" default="nhc12"/>
  <xacro:property name="p" value="$(arg prefix)_"/>

  <group name="${p}manipulator">
    <chain base_link="${p}base_link" tip_link="${p}tool0"/>
  </group>

  <group_state name="home" group="${p}manipulator">
    <joint name="${p}joint_1" value="0"/>
    <joint name="${p}joint_2" value="0"/>
    <joint name="${p}joint_3" value="0"/>
    <joint name="${p}joint_4" value="0"/>
    <joint name="${p}joint_5" value="0"/>
    <joint name="${p}joint_6" value="0"/>
  </group_state>

  <disable_collisions link1="${p}base_link" link2="${p}link_1" reason="Adjacent"/>
  <disable_collisions link1="${p}base_link" link2="${p}link_3" reason="Never"/>
  <disable_collisions link1="${p}link_1" link2="${p}link_2" reason="Adjacent"/>
  <disable_collisions link1="${p}link_1" link2="${p}link_3" reason="Never"/>
  <disable_collisions link1="${p}link_2" link2="${p}link_3" reason="Adjacent"/>
  <disable_collisions link1="${p}link_2" link2="${p}link_5" reason="Never"/>
  <disable_collisions link1="${p}link_2" link2="${p}link_6" reason="Never"/>
  <disable_collisions link1="${p}link_3" link2="${p}link_4" reason="Adjacent"/>
  <disable_collisions link1="${p}link_3" link2="${p}link_5" reason="Never"/>
  <disable_collisions link1="${p}link_3" link2="${p}link_6" reason="Never"/>
  <disable_collisions link1="${p}link_4" link2="${p}link_5" reason="Adjacent"/>
  <disable_collisions link1="${p}link_5" link2="${p}link_6" reason="Adjacent"/>
</robot>
